FROM node:22-bookworm-slim AS build
ARG PUBLIC_API_URL
ARG MOSAIC_APP_ORIGIN
ENV PUBLIC_API_URL=$PUBLIC_API_URL
ENV MOSAIC_APP_ORIGIN=$MOSAIC_APP_ORIGIN
WORKDIR /app
COPY . .
RUN npm ci
RUN npm run build -w @__PROJECT_SLUG__/studio

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3002
WORKDIR /app
COPY --from=build /app/package.json /app/package-lock.json ./
COPY --from=build /app/apps/studio/package.json apps/studio/package.json
COPY --from=build /app/apps/studio/build apps/studio/build
COPY --from=build /app/node_modules node_modules
EXPOSE 3002
CMD ["npm", "run", "start", "-w", "@__PROJECT_SLUG__/studio"]
