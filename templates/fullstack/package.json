{
  "name": "__PROJECT_SLUG__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "__PROJECT_NAME__ - built with Mosaic (Hono API + SvelteKit PWA)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @__PROJECT_SLUG__/api",
