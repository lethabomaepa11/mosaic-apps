    "seed": "mosaic seed",
    "start": "npm run start -w @__PROJECT_SLUG__/api"
  },
  "devDependencies": {
    "@mosaic/cli": "0.1.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
