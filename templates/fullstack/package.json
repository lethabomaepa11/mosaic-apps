{
  "name": "mosaic-fullstack-template",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "migrate": "npm run migrate -w apps/api",
    "seed": "npm run seed -w apps/api"
  },
  "devDependencies": {
    "@mosaic-apps/mosaic-cli": "latest"
  },
  "engines": {
    "node": ">=22"
  }
}