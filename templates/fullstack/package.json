{
  "name": "mosaic-fullstack-template",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm run dev -w @__PROJECT_SLUG__/api",
    "dev:web": "npm run dev -w @__PROJECT_SLUG__/web",
    "dev:studio": "npm run dev -w @__PROJECT_SLUG__/studio",
    "build": "npm run build -w apps/api && npm run build -w apps/web && npm run build -w apps/studio",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "migrate": "mosaic migrate",
    "seed": "mosaic seed"
  },
  "devDependencies": {
    "@sveltejs/kit": "^3.0.1",
    "@mosaic-apps/cli": "^0.2.2"
  },
  "overrides": {
    "@sveltejs/kit": "$@sveltejs/kit"
  },
  "engines": {
    "node": ">=22"
  }
}
