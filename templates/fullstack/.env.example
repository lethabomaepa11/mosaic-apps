# Database
DATABASE_URL=__DB_URL__
# Use a pooled Neon/Supabase URL in serverless production. Keep per-instance pools small.
# MOSAIC_DB_POOL_MAX=2
# MOSAIC_DB_IDLE_TIMEOUT_MS=30000

# Auth (on/off) + session secret (generate: openssl rand -hex 32)
AUTH=on
MOSAIC_JWT_SECRET=change-me-in-production-0123456789abcdef
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Seed on boot (false in production)
SEED=true
SEED_DEMO=true

# Ports
MOSAIC_WEB_PORT=__WEB_PORT__
MOSAIC_STUDIO_PORT=__STUDIO_PORT__
