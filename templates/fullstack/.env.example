# Database
DATABASE_URL=__DB_URL__

# Auth (on/off) + session secret (generate: openssl rand -hex 32)
AUTH=on
MOSAIC_JWT_SECRET=change-me-in-production-0123456789abcdef
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Seed on boot (false in production)
SEED=true
SEED_DEMO=true

# Ports
PORT=__API_PORT__

# Browser/API topology. Leave PUBLIC_API_URL empty when a reverse proxy serves
# /api on the web origin. Otherwise use the full API base, e.g. https://api.example.com/api.
PUBLIC_API_URL=
CORS_ORIGINS=http://localhost:__WEB_PORT__
