# Database
DATABASE_URL=__DB_URL__
# Use a pooled Neon/Supabase URL in serverless production. Keep per-instance pools small.
# MOSAIC_DB_POOL_MAX=2
# MOSAIC_DB_IDLE_TIMEOUT_MS=30000

# Auth (on/off) + session secret (generate: openssl rand -hex 32)
AUTH=on
MOSAIC_JWT_SECRET=change-me-in-production-0123456789abcdef
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional app OAuth. Set the exact public origin and each enabled provider's credentials.
# MOSAIC_OAUTH_ORIGIN=https://app.example.com
# MOSAIC_GOOGLE_CLIENT_ID=
# MOSAIC_GOOGLE_CLIENT_SECRET=
# MOSAIC_GITHUB_CLIENT_ID=
# MOSAIC_GITHUB_CLIENT_SECRET=

# Optional notifications. Select ntfy or resend.
# MOSAIC_NOTIFICATION_PROVIDER=ntfy
# MOSAIC_NTFY_URL=https://ntfy.sh
# MOSAIC_NTFY_TOPIC=
# MOSAIC_NTFY_TOKEN=
# MOSAIC_RESEND_FROM=
# MOSAIC_RESEND_API_KEY=

# Seed on boot (false in production)
SEED=true
SEED_DEMO=true

# Port for the app, its /api and Studio at /studio
MOSAIC_WEB_PORT=__WEB_PORT__
