# Durable PostgreSQL is required in hosted environments. Neon, Supabase, and
# standard PostgreSQL connection strings are supported.
CLOUD_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# The first account and organization are created once when the database is empty.
CLOUD_ADMIN_EMAIL=admin@example.com
CLOUD_ADMIN_PASSWORD=replace-with-at-least-8-characters
CLOUD_ADMIN_NAME=Mosaic Admin
CLOUD_ORGANIZATION_NAME=My workspace

# Groq creates the structured blueprint consumed by generation jobs.
GROQ_API_KEY=gsk_replace-me
GROQ_MODEL=openai/gpt-oss-20b

# Use a long random value. Changing it invalidates every active Cloud session.
CLOUD_SESSION_SECRET=replace-with-a-long-random-secret

# Base64url-encoded 32-byte key used to encrypt provider credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Never change it once set: saved provider connections would no longer decrypt.
CLOUD_PROVIDER_SECRET_KEY=replace-with-a-base64url-encoded-32-byte-key

# Users' GitHub, Vercel and Neon credentials do NOT go here. Each user connects
# their own accounts on Settings → Connections, and projects are created there.
#
# Optional "Connect with …" buttons (OAuth). Without these, users paste a token.
# GitHub OAuth App: github.com/settings/developers → New OAuth App
#   Authorization callback URL: https://<your-cloud-domain>/settings/connections/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Vercel Integration: vercel.com/dashboard/integrations/console → Create
#   Redirect URL: https://<your-cloud-domain>/settings/connections/vercel/callback
#   VERCEL_INTEGRATION_SLUG is the integration's URL name (vercel.com/integrations/<slug>)
VERCEL_INTEGRATION_SLUG=
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=
# Neon offers OAuth only to approved partners, so Neon users paste an API key.
