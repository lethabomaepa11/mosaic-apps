DATABASE_URL=pglite://./data
# Set a stable random MOSAIC_JWT_SECRET of at least 32 characters before production.
MOSAIC_JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional app OAuth. Set the exact public origin and each enabled provider's credentials.
# MOSAIC_OAUTH_ORIGIN=https://app.example.com
# MOSAIC_GOOGLE_CLIENT_ID=
# MOSAIC_GOOGLE_CLIENT_SECRET=
# MOSAIC_GITHUB_CLIENT_ID=
# MOSAIC_GITHUB_CLIENT_SECRET=

# Optional notifications. Select ntfy or resend.
# MOSAIC_NOTIFICATION_PROVIDER=ntfy
# MOSAIC_NTFY_URL=https://ntfy.sh
# MOSAIC_NTFY_TOPIC=
# MOSAIC_NTFY_TOKEN=
# MOSAIC_RESEND_FROM=
# MOSAIC_RESEND_API_KEY=
