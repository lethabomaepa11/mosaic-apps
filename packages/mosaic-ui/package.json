{
  "name": "@mosaic-apps/mosaic-ui",
  "version": "0.1.1",
  "description": "Mosaic enterprise Svelte 5 component kit: 50+ components, drag & drop engine, JSON FormRenderer, API client",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "src"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./style.css": "./src/styles/theme.css",
    "./client": "./src/client/api.ts",
    "./shadcn/*": "./src/shadcn/*/index.ts"
  },
  "scripts": {
    "prepack": "npm run check",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@lucide/svelte": "^1.55.0",
    "@mosaic-apps/mosaic-core": "0.1.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "quickjs-emscripten-core": "^0.32.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.2",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0"
  }
}
