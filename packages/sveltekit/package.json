{
  "name": "@mosaic-apps/sveltekit",
  "version": "0.4.1",
  "description": "SvelteKit route loaders and same-origin API adapters for Mosaic applications",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@mosaic-apps/core": "0.4.0",
    "@mosaic-apps/server": "0.4.1"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0"
  },
  "devDependencies": {
    "@sveltejs/kit": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
}
