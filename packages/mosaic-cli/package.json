{
  "name": "@mosaic/cli",
  "version": "0.1.0",
  "description": "Mosaic CLI: scaffold, migrate, seed and drive Mosaic full-stack apps",
  "type": "module",
  "bin": {
    "mosaic": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "node --import tsx src/index.ts"
  },
  "dependencies": {
    "@mosaic/core": "0.1.0",
    "@mosaic/server": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
}
